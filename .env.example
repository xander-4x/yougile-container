# YouGile Docker Setup — environment variables
# Copy this file to .env and customize as needed.
# Shell environment variables always take precedence over values set here.

# ─── Container runtime ────────────────────────────────────────────────────────
# "docker" (default) or "podman". Affects all exec.Command calls in the installer.
# See README for Podman-specific considerations.
CONTAINER_RUNTIME=docker

# ─── Installer language ───────────────────────────────────────────────────────
# Accepted values: en (default), ru
# Can also be set via CLI flags: --lang=en / --lang=ru
YOUGILE_LANG=en

# ─── Nginx ────────────────────────────────────────────────────────────────────
# Set to false to skip the nginx container (YouGile will be exposed on :8001)
NGINX_ENABLED=true

# Host ports mapped to nginx container (change if 80/443 are already in use)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ─── Resource limits ──────────────────────────────────────────────────────────
# Leave empty to impose no limits.
# Memory accepts Docker units: 512m, 1g, 2g, etc.
# CPU is a decimal number of cores: 1, 0.5, 2, etc.
YOUGILE_MEM_LIMIT=
YOUGILE_CPU_LIMIT=
NGINX_MEM_LIMIT=
NGINX_CPU_LIMIT=

# ─── Air-gapped / private registry deployment ─────────────────────────────────
# Override any of the values below to point at your internal mirror
# or artifact repository.

# YouGile application archive (downloaded by the installer before docker build)
YOUGILE_DOWNLOAD_URL=https://dist.yougile.com/linux/latest/yougile.tar.gz

# SHA-256 checksum of the archive (hex string). Leave empty to skip verification.
# Obtain with: sha256sum yougile.tar.gz
YOUGILE_CHECKSUM=

# Docker images — pin to a specific digest for reproducible builds, e.g.:
#   YOUGILE_NODE_IMAGE=node:22.3.0@sha256:<digest>
#   YOUGILE_NGINX_IMAGE=nginx:1.27-alpine@sha256:<digest>
YOUGILE_NODE_IMAGE=node:22.3.0
YOUGILE_NGINX_IMAGE=nginx:alpine
YOUGILE_CERTBOT_IMAGE=certbot/certbot:latest
